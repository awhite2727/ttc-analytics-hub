    create  table
      "analytics"."main"."route_stops__dbt_tmp"
  
    as (
      

-- Map stop coordinates to routes

SELECT  DISTINCT t.route_id,
        t.direction_id,
        s.stop_id,
        s.stop_name,
        s.stop_lat,
        s.stop_lon

