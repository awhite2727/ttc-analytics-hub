    create  table
      "analytics"."main"."int_route_shapes_lookup__dbt_tmp"
  
    as (
      

-- For each unique route & direction (A/B), returns the most frequently used route shape

SELECT  route_id,
        trip_short_name,
        shape_id
FROM "analytics"."main"."stg_trips"
WHERE shape_id IS NOT NULL
GROUP BY  route_id,
          trip_short_name,
          shape_id QUALIFY ROW_NUMBER() OVER ( PARTITION BY route_id,trip_short_name ORDER BY  COUNT(*) DESC ) = 1
    );
  
  
