      "analytics"."main"."get_routes__dbt_tmp"
  
    as (
      -- Clean routes layer

with route_colour as (
    select route_id, route_color,
    from "analytics"."main"."stg_routes"
)

SELECT  r.route_id,
        l.trip_name,
        l.direction_id,
        s.coordinates,
        r.route_color
FROM route_colour r
JOIN "analytics"."main"."route_shapes_lookup" l ON r.route_id = l.route_id
