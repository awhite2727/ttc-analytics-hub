        CASE WHEN wheelchair_accessible = 1 THEN true else false end AS is_accessible, 
        CASE WHEN bikes_allowed = 1 THEN true else false end AS is_bike_allowed

FROM '../backend/data/gtfs_raw/static_trips.csv'
    );
  
  
