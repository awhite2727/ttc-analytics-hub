        t.direction_id,
        s.stop_id,
        s.stop_name,
        s.stop_lat,
        s.stop_lon

FROM select_trip t
JOIN select_stops s ON t.trip_id = s.trip_id
JOIN "analytics"."main"."stops" s2 ON s.stop_id = s2.stop_id
    );
  
  
